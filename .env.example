# TikTok Streak Bot v2.0 Configuration
# Created by: Duc Anh
#
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=TikTok Streak API
APP_ENV=development

# =============================================================================
# API Authentication
# =============================================================================
API_KEY=your-secure-api-key-here

# =============================================================================
# Telegram Notifications
# =============================================================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
TELEGRAM_ENABLED=true
TELEGRAM_LOG_ENABLED=true
TELEGRAM_LOG_LEVEL=WARNING

# =============================================================================
# Bot Settings
# =============================================================================

# Pool tin nhắn chung — bot sẽ RANDOM chọn 1 câu mỗi lần chạy
# Dùng | để ngăn cách nhiều câu
MESSAGES=🔥 Streak! 🔥|Nhớ giữ streak nhe!|Hôm nay cũng streak!

# Tuỳ chỉnh tin nhắn theo từng thứ trong tuần (để trống = dùng MESSAGES bên trên)
# Dùng | để có nhiều câu cho cùng 1 ngày (bot sẽ random chọn 1)
MESSAGE_MON=Thứ Hai năng lượng! 💪|Đầu tuần streak mạnh!
MESSAGE_TUE=Thứ Ba vui vẻ! 😄
MESSAGE_WED=Giữa tuần rồi! 🌟|Streak Wednesday!
MESSAGE_THU=Sắp cuối tuần! 🎉
MESSAGE_FRI=Thứ Sáu rồi! 🥳|TGIF streak!
MESSAGE_SAT=Cuối tuần thư giãn nhưng vẫn streak! 🌈
MESSAGE_SUN=Chủ Nhật yên bình ☀️|Streak ngày nghỉ!

# (Tuỳ chọn) Giữ lại MESSAGE cũ để tương thích ngược — sẽ bị bỏ qua nếu có MESSAGES
# MESSAGE=streak


# Interval in minutes (interval mode, default 23 hours = 1380 min)
SCHEDULE_INTERVAL_MINUTES=1380

# =============================================================================
# Reliability Settings (v2.0)
# =============================================================================
# Max retry attempts per contact (exponential backoff: 2s, 4s, 8s...)
MAX_RETRIES_PER_CONTACT=4

# Skip unreachable contacts and continue with others (true/false)
SKIP_UNREACHABLE=true

# Don't re-send to contacts already messaged today (true/false)
DAILY_COOLDOWN=true

# Check internet connectivity before starting (true/false)
NETWORK_CHECK=true

# =============================================================================
# Browser Settings
# =============================================================================
HEADLESS_MODE=false
PAGE_LOAD_WAIT=5
ELEMENT_WAIT=3
MESSAGE_SEND_DELAY=2

# =============================================================================
# Server Settings
# =============================================================================
HOST=0.0.0.0
PORT=8000
