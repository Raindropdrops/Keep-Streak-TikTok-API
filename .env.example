# TikTok Streak Bot v2.0 Configuration
# Created by: Duc Anh
#
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=TikTok Streak API
APP_ENV=development

# =============================================================================
# API Authentication
# =============================================================================
API_KEY=your-secure-api-key-here

# =============================================================================
# Telegram Notifications
# =============================================================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
TELEGRAM_ENABLED=true
TELEGRAM_LOG_ENABLED=true
TELEGRAM_LOG_LEVEL=WARNING

# =============================================================================
# Bot Settings
# =============================================================================

# Pool tin nhắn chung dự phòng — chỉ dùng khi ngày hiện tại không có MESSAGE_*
# Dùng | để ngăn cách nhiều câu
MESSAGES=Chúc bạn một ngày thật vui và nhiều năng lượng nhé!|Mong hôm nay sẽ mang đến cho bạn nhiều điều tốt đẹp!

# Tin nhắn theo từng thứ trong tuần, tính theo múi giờ Việt Nam.
# Dùng | để có nhiều câu cho cùng một ngày; bot luân phiên để hạn chế lặp.
MESSAGE_MON=Chúc bạn tuần mới nhiều năng lượng, mọi việc đều thuận lợi nhé!|Tuần mới bắt đầu rồi, chúc bạn có thật nhiều niềm vui và may mắn!
MESSAGE_TUE=Chúc bạn một ngày thứ Ba nhẹ nhàng, làm gì cũng suôn sẻ nhé!|Hôm nay nhớ dành một chút thời gian nghỉ ngơi và chăm sóc bản thân nha!
MESSAGE_WED=Đã giữa tuần rồi, chúc bạn luôn giữ được năng lượng tích cực nhé!|Chúc bạn một ngày bình an và có thêm nhiều niềm vui nho nhỏ!
MESSAGE_THU=Chúc bạn hôm nay làm việc hiệu quả và gặp nhiều chuyện dễ thương nhé!|Cuối tuần đang đến gần rồi, cố gắng thêm một chút và nhớ nghỉ ngơi nha!
MESSAGE_FRI=Thứ Sáu rồi, chúc bạn kết thúc tuần thật trọn vẹn và vui vẻ!|Chúc bạn hôm nay nhiều niềm vui, tối đến được thư giãn thật thoải mái!
MESSAGE_SAT=Cuối tuần rồi, chúc bạn có thời gian nghỉ ngơi và làm điều mình thích nhé!|Chúc bạn một ngày thứ Bảy thật vui, nhẹ nhàng và nhiều tiếng cười!
MESSAGE_SUN=Chủ Nhật bình yên nhé, mong bạn có một ngày thật thư thái bên những người thân yêu!|Chúc bạn nghỉ ngơi thật tốt để sẵn sàng cho một tuần mới nhiều điều hay!

# (Tuỳ chọn) Giữ lại MESSAGE cũ để tương thích ngược — sẽ bị bỏ qua nếu có MESSAGES
# MESSAGE=streak


# Interval in minutes (interval mode, default 23 hours = 1380 min)
SCHEDULE_INTERVAL_MINUTES=1380

# =============================================================================
# Reliability Settings (v2.0)
# =============================================================================
# Max retry attempts per contact (exponential backoff: 2s, 4s, 8s...)
MAX_RETRIES_PER_CONTACT=4

# Skip unreachable contacts and continue with others (true/false)
SKIP_UNREACHABLE=true

# Don't re-send to contacts already messaged today (true/false)
DAILY_COOLDOWN=true

# Check internet connectivity before starting (true/false)
NETWORK_CHECK=true

# =============================================================================
# Browser Settings
# =============================================================================
HEADLESS_MODE=false
PAGE_LOAD_WAIT=5
ELEMENT_WAIT=3
MESSAGE_SEND_DELAY=2

# =============================================================================
# Server Settings
# =============================================================================
HOST=0.0.0.0
PORT=8000
